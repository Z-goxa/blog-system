# MariaDB 数据库配置
# 请根据你的实际配置修改以下参数

# 数据库主机（默认：localhost）
DB_HOST=localhost

# 数据库端口（默认：3306）
DB_PORT=3306

# 数据库用户名（默认：root）
DB_USER=root

# 数据库密码（必填，改为你的实际密码）
DB_PASSWORD=9385302

# 数据库名称（默认：blog_db）
DB_NAME=blog_db

# 连接池配置
# 最大打开连接数（默认：25）
DB_MAX_OPEN_CONNS=25

# 最大空闲连接数（默认：10）
DB_MAX_IDLE_CONNS=10

# 连接最大生命周期（秒，默认：300）
DB_CONN_MAX_LIFETIME=300

# 空闲连接最大存活时间（秒，默认：120）
DB_CONN_MAX_IDLE_TIME=120

# JWT 签名密钥（必填；用 openssl rand -hex 32 生成）
JWT_SECRET=change-me-please-use-openssl-rand-hex-32
